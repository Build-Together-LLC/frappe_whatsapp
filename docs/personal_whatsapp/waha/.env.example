# Copy to .env and replace every value. Generate secrets with: openssl rand -hex 24
# WAHA_API_KEY holds the SHA-512 hash; the ERP stores the plain key.
#   PLAIN=$(openssl rand -hex 24); echo "$PLAIN"; echo "sha512:$(echo -n "$PLAIN" | sha512sum | cut -d' ' -f1)"
WAHA_API_KEY=sha512:replace-with-the-sha512-hash-of-your-plain-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=replace-with-a-long-random-password
# 127.0.0.1 keeps WAHA private (use this behind nginx on a VPS). Use 0.0.0.0 only on a closed network.
WAHA_BIND=127.0.0.1
