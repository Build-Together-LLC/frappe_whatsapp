server {
    listen 80;
    server_name waha.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name waha.example.com;

    ssl_certificate     /etc/letsencrypt/live/waha.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/waha.example.com/privkey.pem;

    allow 203.0.113.10;   # the ERP server's public IP
    deny  all;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
